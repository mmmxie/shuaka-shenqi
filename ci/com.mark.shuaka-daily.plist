<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mark.shuaka-daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/m.hsieh/Downloads/Mark-Agent/shuaka-repo/ci/local_daily_update.sh</string>
  </array>

  <!-- 每天英國時間 09:00。
       用 launchd 而不是 crontab：電腦睡眠或關機時錯過的排程，
       launchd 會在下次喚醒時補跑一次，crontab 會直接跳過。 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/m.hsieh/Downloads/Mark-Agent/shuaka-repo/ci/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/m.hsieh/Downloads/Mark-Agent/shuaka-repo/ci/logs/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
